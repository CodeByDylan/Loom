<Project>

    <!-- Applies to every project. Individual .csproj files must not redeclare these. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- Identifies src/ projects (shipped packages) vs tests/ projects. -->
    <PropertyGroup>
        <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
        <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
        <!-- Detected from the name rather than a flag in the project. This file is imported before the
             project's own properties, so a flag set there would be read here as unset. -->
        <IsAnalyzerProject Condition="$(MSBuildProjectName.EndsWith('.Analyzers'))">true</IsAnalyzerProject>
        <IsAnalyzerProject Condition="'$(IsAnalyzerProject)' == ''">false</IsAnalyzerProject>
    </PropertyGroup>

    <!-- Shipped packages: documented, packable, versioned from git tags. -->
    <PropertyGroup Condition="'$(IsTestProject)' == 'false'">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <!-- The identifier is prefixed with the organisation; the namespaces and assemblies are not.
             Only the identifier needs the prefix, because that is what nuget.org can reserve — and
             "Loom." cannot be: it is a common word, it does not identify anyone, and eighteen packages
             under it already belong to other authors. Meanwhile `using Loom.Results;` stays what a
             consumer types all day. Precedent: AWSSDK.S3 ships the Amazon.S3 namespace. -->
        <PackageId>CodeByDylan.$(MSBuildProjectName)</PackageId>
        <Authors>Dylan de Beer</Authors>
        <PackageProjectUrl>https://github.com/CodeByDylan/Loom</PackageProjectUrl>
        <RepositoryUrl>https://github.com/CodeByDylan/Loom</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Every package ships in lockstep from one repo-wide tag, e.g. "v0.3.0". -->
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsTestProject)' == 'false'">
        <PackageReference Include="MinVer" PrivateAssets="all" />
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- Test projects: never packaged, never require XML docs. -->
    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Analyzer projects. Declared last so it wins over the shipped-package settings above.
         The compiler only loads analyzers built against netstandard2.0, so this is the one kind of
         project whose framework is not net10.0 — which is why the exception lives here rather than in
         a .csproj: TargetFramework still has exactly one owner, it just has two answers. Not packable
         itself; its assembly is packed into the library it enforces. -->
    <PropertyGroup Condition="'$(IsAnalyzerProject)' == 'true'">
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

</Project>
